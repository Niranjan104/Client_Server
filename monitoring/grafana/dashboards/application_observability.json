  "panels": [
    {
      "title": "Backend Availability",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "max by (slot) (up{job=\"tea_server\"})",
          "legendFormat": "{{slot}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      }
    },
    {
      "title": "Request Rate by Route",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum by (route, app_version) (rate(tea_http_requests_total{route!=\"/metrics\"}[5m]))",
          "legendFormat": "{{app_version}} {{route}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      }
    },
    {
      "title": "P95 Request Latency",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, route, app_version) (rate(tea_http_request_duration_seconds_bucket{route!=\"/metrics\"}[5m])))",
          "legendFormat": "{{app_version}} {{route}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      }
    },
    {
      "title": "Orders Created",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum by (app_version) (rate(tea_orders_created_total[5m]))",
          "legendFormat": "{{app_version}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      }
    },
    {
      "title": "Open Unpaid Orders",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum by (app_version) (tea_unpaid_orders)",
          "legendFormat": "{{app_version}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      }
    },
    {
      "title": "Revenue Generated Over Range",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum by (app_version) (increase(tea_order_value_rupees_total[$__range]))",
          "legendFormat": "{{app_version}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      }
    }
  ],
